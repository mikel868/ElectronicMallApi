# =========================================================
#  ElectronicMall 环境变量模板
#  使用：cp .env.example .env 然后填入实际值
#  权限：chmod 600 .env （仅所有者可读）
# =========================================================

# ---- Spring ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=9191

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-this-to-strong-password
MYSQL_DB=electronic_mall
MYSQL_USER=mall_app
MYSQL_PASSWORD=change-this-too

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-this-redis-pwd

# ---- Elasticsearch (临时关闭；重新启用请取消注释并恢复 docker-compose 中的 es 服务) ----
# APP_ES_ENABLED=true
# ES_HOST=es
# ES_PORT=9200
# ES_CLUSTER_NAME=elasticsearch
# ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---- LLM (DashScope / 通义千问) ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-dashscope-api-key
LLM_CHAT_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3

# ---- JWT ----
JWT_SECRET=use-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=1440

# ---- CORS ----
# 生产环境改为前端实际域名/IP，逗号分隔，不要用 *
CORS_ALLOWED_ORIGINS=http://your-server-ip

# ---- 文件存储 ----
STORAGE_BACKEND=local
STORAGE_LOCAL_BASE_PATH=/opt/mall/data

# ---- 日志 ----
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
LANGCHAIN4J_LOG_LEVEL=WARN

# ---- JVM ----
JAVA_OPTS=-Xms512m -Xmx1g
