<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rabbiter.em.mapper.SeckillVoucherMapper">

    <resultMap id="SeckillVoucherResultMap" type="com.rabbiter.em.entity.SeckillVoucher">
        <id column="id" property="id"/>
        <result column="voucher_amount" property="voucherAmount"/>
        <result column="min_amount" property="minAmount"/>
        <result column="stock" property="stock"/>
        <result column="begin_time" property="beginTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 查询进行中的秒杀券 -->
    <select id="selectActiveSeckills" resultMap="SeckillVoucherResultMap">
        SELECT * FROM voucher 
        WHERE status = 1 
          AND begin_time &lt;= NOW() 
          AND end_time &gt;= NOW() 
          AND stock > 0
        ORDER BY begin_time ASC
    </select>

</mapper>